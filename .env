# Environment variables for Brain-Swarm
# Copy this file to .env and fill in your actual values

# OpenAI API Key for AI features (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Grafana Admin Password (default: admin)
GRAFANA_ADMIN_PASSWORD=admin

# Redis Configuration
REDIS_URL=redis://redis:6379

# Database Configuration
DUCKDB_PATH=data/cortex.duckdb
DATABASE_URL=sqlite:///data/brain_swarm.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Prometheus Configuration
PROMETHEUS_URL=http://prometheus:9090

# Scalability Configuration
SCALABILITY__ENABLED=false
SCALABILITY__MESSAGE_QUEUE_MODE=single_node
SCALABILITY__REDIS_URLS=["redis://redis:6379"]
SCALABILITY__PARTITIONS=8
SCALABILITY__ASYNC_AGENTS_ENABLED=false
SCALABILITY__AGENT_POOL_MIN=1
SCALABILITY__AGENT_POOL_MAX=10
SCALABILITY__LOAD_BALANCING_STRATEGY=least_loaded
SCALABILITY__MULTI_CLUSTER_ENABLED=false
SCALABILITY__CLUSTER_ID=default_cluster
SCALABILITY__CLUSTER_ROLE=primary
SCALABILITY__AUTO_SCALING_ENABLED=false

# Node Configuration
NODE__NODE_NAME=brain_swarm_api
NODE__SWARM_ID=default_swarm
NODE__HOST=0.0.0.0
NODE__PORT=8000

# Federation Configuration
FEDERATION__ENABLED=false

# Logging Configuration
LOGGING__LEVEL=INFO

# Environment
ENVIRONMENT=development
