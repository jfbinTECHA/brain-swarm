# === Core Service URLs ===
REDIS_URL=redis://localhost:6379
CHROMA_URL=http://localhost:8000
DUCKDB_PATH=/home/sysop/brainswarm/data/cortex.duckdb

# === API + Secrets ===
OPENAI_API_KEY=your-openai-key
JWT_SECRET=brainswarmsecret
DATABASE_URL=sqlite:///data/brainswarm.db

# === Cortex Summarizer Configuration ===
REDIS_URL=redis://localhost:6379
CHROMA_URL=http://localhost:8000
DUCKDB_PATH=/home/sysop/brainswarm/data/cortex.duckdb
S3_BUCKET=brainswarm-cortex

# Optional fine-tuning
SUMMARIZATION_INTERVAL=300
EMBEDDING_MODEL=text-embedding-3-large
CORTEX_MODE=live

# Notes:
#   Pydantic's BaseSettings parser requires clean, comment-free values.
#   Do NOT append inline comments or spaces after values.
#   Use only whole integers for intervals (in seconds).
#   Comments like this should live on separate lines starting with '#'.