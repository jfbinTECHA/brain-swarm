[Unit]
Description=BrainSwarm Cortex Summarizer
After=network.target redis.service

[Service]
Type=simple
# Continuous summarizer loop mode
WorkingDirectory=/home/sysop/brainswarm
EnvironmentFile=/home/sysop/brainswarm/.env
ExecStart=/home/sysop/brainswarm/scripts/summarizer_loop.sh
Restart=always
RestartSec=10
User=sysop
StandardOutput=append:/home/sysop/brainswarm/logs/summarizer.log
StandardError=append:/home/sysop/brainswarm/logs/summarizer.err

[Install]
WantedBy=multi-user.target