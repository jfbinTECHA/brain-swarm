# Brain Swarm Configuration
# Copy this file to .env and fill in your values

# Environment
ENVIRONMENT=development

# API Keys
API_KEYS__OPENAI_API_KEY=your_openai_key_here
API_KEYS__OPENROUTER_API_KEY=your_openrouter_key_here
API_KEYS__ANTHROPIC_API_KEY=your_anthropic_key_here
API_KEYS__GROK_API_KEY=your_grok_key_here

# Node Configuration
NODE__NODE_NAME=brain_swarm_node_1
NODE__SWARM_ID=default_swarm
NODE__HOST=0.0.0.0
NODE__PORT=8000
NODE__MAX_AGENTS=10
NODE__MAX_AGENT_LOAD=3

# Database
DATABASE__URL=sqlite:///brain_swarm.db
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=10

# Logging
LOGGING__LEVEL=INFO
LOGGING__FILE_PATH=logs/brain_swarm.log

# Federation
FEDERATION__ENABLED=false
FEDERATION__DISCOVERY_URL=http://federation-discovery:8080
FEDERATION__SHARED_MEMORY_URL=redis://shared-memory:6379

# Scalability (for horizontal scaling and Redis-backed message bus)
SCALABILITY__ENABLED=false
SCALABILITY__MESSAGE_QUEUE_MODE=single_node
SCALABILITY__REDIS_URLS=["redis://localhost:6379"]
SCALABILITY__PARTITIONS=8
SCALABILITY__ASYNC_AGENTS_ENABLED=false
SCALABILITY__AGENT_POOL_MIN=1
SCALABILITY__AGENT_POOL_MAX=10
SCALABILITY__LOAD_BALANCING_STRATEGY=least_loaded
SCALABILITY__MULTI_CLUSTER_ENABLED=false
SCALABILITY__CLUSTER_ID=default_cluster
SCALABILITY__CLUSTER_ROLE=primary
SCALABILITY__AUTO_SCALING_ENABLED=false

# Security
SECURITY__ENABLE_POLICY_ENGINE=true
SECURITY__ENABLE_ENCRYPTION=false
SECURITY__JWT_SECRET=your_jwt_secret_here_change_in_production
SECURITY__JWT_ALGORITHM=HS256
SECURITY__JWT_EXPIRATION_HOURS=24
SECURITY__API_KEYS__VISION_AGENT=vision_api_key_here
SECURITY__API_KEYS__LANGUAGE_AGENT=language_api_key_here
SECURITY__API_KEYS__MATH_AGENT=math_api_key_here
SECURITY__API_KEYS__SIMULATION_AGENT=simulation_api_key_here