# Environment variables for Cortex AI Prototype
# Copy this file to .env and fill in your actual values

# OpenAI API Key for AI features (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Grafana Admin Password (default: admin)
GRAFANA_ADMIN_PASSWORD=admin

# Redis Configuration
REDIS_URL=redis://cortex-redis:6379

# Database Configuration
DUCKDB_PATH=/data/cortex.duckdb
DATABASE_URL=postgresql://postgres:swarm@localhost:5432/brainswarm

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001

# Prometheus Configuration
PROMETHEUS_URL=http://cortex-prometheus:9090