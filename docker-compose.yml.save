services:
  stm:
    image: redis:7.4
    container_name: cortex-stm
    restart: always
    volumes:
      - ./data/redis:/data
    ports:
      - "6379:6379"

analytics:
    image: duckdb/duckdb:latest
    container_name: cortex-duckdb
    entrypoint: ["sleep", "infinity"]
    volumes:
      - ./data/duckdb/cortex.duckdb:/data/cortex.duckdb


  cortex-api:
    image: python:3.12-slim
    container_name: cortex-api
    working_dir: /app
    environment:
      - OPENAI_API_KEY=${OPENAI_API_KEY}
      - REDIS_URL=${REDIS_URL}
      - DUCKDB_PATH=${DUCKDB_PATH}
      - CORTEX_MODE=${CORTEX_MODE}
    volumes:
      - ./backend:/app
      - ./data:/data
    ports:
      - "8001:8001"
    command: bash -c "pip install fastapi uvicorn redis duckdb openai && uvicorn main:app --host 0.0.0.0 --port 8001"

  dashboard:
    image: grafana/grafana:10.2.0
    container_name: cortex-grafana
    environment:
      - GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFAN    restart: always

