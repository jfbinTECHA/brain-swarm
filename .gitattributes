# Git attributes for proper handling of files

# Binary files - don't diff
*.db binary
*.duckdb binary
*.rdb binary
*.db-wal binary
*.db-shm binary

# Large files
*.log filter=lfs diff=lfs merge=lfs -text

# Text files
*.md text
*.yml text
*.yaml text
*.py text
*.json text
*.sh text

# Docker
Dockerfile text
docker-compose*.yml text