graph TB
    %% Main Title
    subgraph "Brain Swarm Federation Architecture"
        TITLE[Brain Swarm Federation:<br/>LAN + Global Discovery Architecture]

        %% Three Main Scenarios
        subgraph "🌐 INTERNET-WIDE DISCOVERY"
            INT_TITLE[Internet-Wide Federation]

            subgraph "Network A"
                SWARM_A1[Swarm Instance<br/>Network A]
                DISC_A1[Discovery Layer<br/>Hybrid Mode]
                FED_A1[Federation Manager<br/>WebSocket]
                REG_CLIENT_A[Registry Client<br/>TLS/HTTPS]
            end

            subgraph "Network B"
                SWARM_B1[Swarm Instance<br/>Network B]
                DISC_B1[Discovery Layer<br/>Hybrid Mode]
                FED_B1[Federation Manager<br/>WebSocket]
                REG_CLIENT_B[Registry Client<br/>TLS/HTTPS]
            end

            subgraph "🌍 CENTRAL REGISTRY SERVICE"
                REGISTRY[(Central Registry<br/>Secure API)]
                API_AUTH[API Key Auth<br/>X-API-Key Header]
                SWARM_DB[(Swarm Registry<br/>Database)]
                RATE_LIMIT[Rate Limiting<br/>per key/minute]
                HEALTH_MON[Health Monitoring<br/>& Auto Cleanup]
                AUDIT_LOG[Audit Logging<br/>All Operations]
            end
        end

        subgraph "🏠 LAN-ONLY DISCOVERY"
            LAN_TITLE[LAN-Only Federation]

            subgraph "Same LAN Network"
                SWARM_LAN1[Swarm Instance<br/>LAN]
                DISC_LAN1[Discovery Layer<br/>UDP Mode]
                FED_LAN1[Federation Manager<br/>WebSocket]
                UDP_LAN1[UDP Broadcast<br/>Port 9999]

                SWARM_LAN2[Swarm Instance<br/>LAN]
                DISC_LAN2[Discovery Layer<br/>UDP Mode]
                FED_LAN2[Federation Manager<br/>WebSocket]
                UDP_LAN2[UDP Broadcast<br/>Port 9999]
            end
        end

        subgraph "🔄 HYBRID DISCOVERY MODE"
            HYBRID_TITLE[Hybrid Federation]

            subgraph "Enterprise Environment"
                SWARM_HYB[Swarm Instance<br/>Enterprise LAN]
                DISC_HYB[Discovery Layer<br/>Hybrid Mode]
                FED_HYB[Federation Manager<br/>WebSocket]

                subgraph "LAN Discovery"
                    UDP_HYB[UDP Broadcast<br/>Port 9999]
                end

                subgraph "Global Discovery"
                    REG_HYB[Registry Client<br/>TLS/HTTPS]
                end
            end

            PRIORITY[Discovery Priority Logic<br/>1. LAN First (fast)<br/>2. Registry Query<br/>3. Merge Results<br/>4. Fallback Available<br/>5. Auto-retry Failed]
        end
    end

    %% Security Architecture
    subgraph "🔐 SECURITY LAYERS"
        SEC_TITLE[Security Architecture]

        subgraph "Transport Security"
            TLS[TLS/HTTPS<br/>Encryption]
            CERT[Certificate<br/>Validation]
            HEADERS[Secure<br/>Headers]
        end

        subgraph "Authentication"
            API_KEYS[API Key<br/>Generation]
            HASH_STORE[Secure Hash<br/>Storage]
            KEY_ROTATE[Key<br/>Rotation]
            PERMS[Permission<br/>Levels]
        end

        subgraph "Authorization"
            READ_WRITE[Read/Write/Admin<br/>Permissions]
            OWNERSHIP[Resource<br/>Ownership]
            ACL[Access Control<br/>Lists]
        end

        subgraph "Operational Security"
            RATE_LIM[Rate<br/>Limiting]
            VALIDATION[Input<br/>Validation]
            AUDIT[Audit<br/>Logging]
            IDS[Intrusion<br/>Detection]
        end
    end

    %% Data Flow
    subgraph "📊 DATA FLOW ARCHITECTURE"
        FLOW_TITLE[Discovery Flow]

        subgraph "LAN Path"
            LAN_BROADCAST[Swarm A UDP<br/>Broadcast]
            LAN_RECEIVE[Swarm B Receives<br/>Broadcast]
            LAN_EXTRACT[Extract<br/>Metadata]
            LAN_WS[WebSocket<br/>Connection]
            LAN_ESTABLISHED[Federation<br/>Established]
        end

        subgraph "Global Path"
            REG_REGISTER[Swarm A Registers<br/>with Registry]
            REG_QUERY[Swarm B Queries<br/>Registry]
            REG_RETURN[Registry Returns<br/>Metadata]
            REG_WS[WebSocket<br/>Connection]
            REG_ESTABLISHED[Federation<br/>Established]
        end

        subgraph "Hybrid Path"
            HYB_LAN[Try LAN<br/>Discovery First]
            HYB_REGISTRY[Query Global<br/>Registry]
            HYB_MERGE[Merge Results<br/>from Both]
            HYB_PRIORITIZE[Prioritize LAN<br/>Discoveries]
            HYB_FALLBACK[Fallback to<br/>Available]
            HYB_ESTABLISH[Establish All<br/>Federations]
        end
    end

    %% Performance Comparison
    subgraph "⚡ PERFORMANCE CHARACTERISTICS"
        PERF_TITLE[Discovery Method Comparison]

        subgraph "UDP Broadcast (LAN)"
            UDP_LAT[Latency: < 1 second]
            UDP_SCALE[Scalability: 100-1000 nodes]
            UDP_SEC[Security: Network isolation]
            UDP_REL[Reliability: High (local)]
            UDP_COST[Cost: Zero external deps]
        end

        subgraph "Registry-Based (Internet)"
            REG_LAT[Latency: 1-5 seconds]
            REG_SCALE[Scalability: 1000+ nodes]
            REG_SEC[Security: TLS + API keys]
            REG_REL[Reliability: Registry dependent]
            REG_COST[Cost: Registry maintenance]
        end

        subgraph "Hybrid Mode"
            HYB_LAT[Latency: < 1s / 1-5s]
            HYB_SCALE[Scalability: Unlimited]
            HYB_SEC[Security: LAN + Internet]
            HYB_REL[Reliability: High (fallback)]
            HYB_COST[Cost: Minimal (registry optional)]
        end
    end

    %% Deployment Scenarios
    subgraph "🚀 DEPLOYMENT SCENARIOS"
        DEPLOY_TITLE[Deployment Options]

        subgraph "Single Network"
            SINGLE_LAN[All swarms on same<br/>broadcast domain]
            SINGLE_UDP[UDP discovery<br/>sufficient]
            SINGLE_NO_INET[No internet<br/>connectivity needed]
            SINGLE_FAST[Fastest discovery<br/>method]
        end

        subgraph "Enterprise Multi-Site"
            ENTERPRISE_MULTI[Swarms across<br/>multiple LANs]
            ENTERPRISE_VPN[VPN connectivity<br/>between sites]
            ENTERPRISE_HYBRID[Hybrid LAN + Registry<br/>discovery]
            ENTERPRISE_CENTRAL[Centralized<br/>management]
        end

        subgraph "Global Internet"
            GLOBAL_INET[Swarms on public<br/>internet]
            GLOBAL_REGISTRY[Registry service<br/>required]
            GLOBAL_TLS[Full TLS/HTTPS<br/>security]
            GLOBAL_API[API key auth<br/>mandatory]
        end

        subgraph "Hybrid Enterprise + Cloud"
            HYB_ENT_CLOUD[On-premises + Cloud<br/>swarms]
            HYB_AUTO_CROSS[Automatic cross-environment<br/>discovery]
            HYB_UNIFIED[Unified federation<br/>management]
        end
    end

