    classDef titleClass fill:#fff3e0,stroke:#f57c00,stroke-width:3px,font-size:16px

    class TITLE titleClass
    class SWARM_A1,SWARM_A2,SWARM_B1,SWARM_B2,SWARM_C1,SWARM_D1 swarmClass
    class REGISTRY,API_KEYS,SWARM_DB,AUDIT_LOG,RATE_LIMIT registryClass
    class TASK_FLOW,MEMORY_FLOW,ANALYTICS_FLOW flowClass
    class DISCOVERY_LEGEND,SECURITY_LEGEND,FEDERATION_LEGEND,HYBRID_DISC,AUTO_SECURITY,SCALABLE_FED,RESILIENT_COMM securityClass

